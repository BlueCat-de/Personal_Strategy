# Copy this file to .env.local and fill in your own credentials.
# Do not commit .env.local.

# Tushare Pro token.
TUSHARE_TOKEN=replace_with_your_tushare_token

# Optional local strategy/runtime overrides.
LOCAL_STRATEGY_VERSION=v4
LOCAL_STRATEGY_START_DATE=2025-07-05
LOCAL_WARMUP_START_DATE=2025-01-07
LOCAL_INITIAL_CASH=100000

# Optional daemon execution overrides.
# Prefer LOCAL_PYTHON on servers. If empty, ashare-daemon falls back to
# `conda run -n LOCAL_CONDA_ENV python`.
LOCAL_PYTHON=/path/to/your/venv/bin/python
LOCAL_CONDA_ENV=strategy
