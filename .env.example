# Copy this file to .env.local and fill in your own credentials.
# Do not commit .env.local.

# BigQuant SDK key. Supported formats:
#   1. token format from BigQuant console
#   2. AK.SK format, where AK and SK are separated by a dot
BIGQUANT_API_KEY=replace_with_your_primary_bigquant_key

# Optional backup key. The data adapter will switch to this key when the
# primary key reports quota exhaustion.
BIGQUANT_API_KEY2=

# Optional daemon/runtime overrides.
BIGQUANT_STRATEGY_VERSION=v4
BIGQUANT_STRATEGY_START_DATE=2025-07-05
BIGQUANT_WARMUP_START_DATE=2025-01-07
BIGQUANT_INITIAL_CASH=100000
